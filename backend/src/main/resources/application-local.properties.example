# 내 PC 설정 견본입니다. 이 파일을 복사해서 이름을 application-local.properties로 바꾸고 값을 채우세요.
# application-local.properties는 .gitignore에 있어서 커밋되지 않습니다. 키·비밀번호는 거기에만 적습니다.
# 비운 값은 "없음"으로 처리돼요(Gemini 두 줄만 예외, 아래 참고). 키가 없어도 서버는 켜지고, 그 기능만 대신 동작(추정·규칙)합니다.

# DB: PostgreSQL 계정 (설치할 때 정한 postgres 비밀번호. pgAdmin master password 아님)
DB_USERNAME=postgres
DB_PASSWORD=

# Gemini (Google AI Studio). 키를 받으면 앞의 #을 지우고 값을 넣어요.
# 빈 값(GEMINI_API_KEY=)으로 두면 서버가 안 켜져요. 쓰지 않을 땐 # 주석 그대로. 모델은 주석이면 gemini-3.8-flash
# GEMINI_API_KEY=
# GEMINI_MODEL=

# 카카오 (JS 키는 지도, REST 키는 DB에 없는 장소 위치 찾기)
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# 길찾기 (TMAP → 실패하면 ODsay → 없으면 거리로 추정)
TMAP_APP_KEY=
ODSAY_API_KEY=

# 공공데이터포털 (TourAPI 장소 찾기, 기상청 단기예보). Decoding 키
TOUR_API_KEY=
KMA_SERVICE_KEY=

# 서울 열린데이터광장 (실시간 도시데이터 인구 혼잡도, ② 11/12). 일반 인증키
SEOUL_API_KEY=

# 개발자 모드(시연 시계)를 쓸 시연 계정 아이디. 쉼표로 여러 개 (예: qwer1234,tripuser). 이 줄이 없거나 비어 있으면 qwer1234 (db/96_demo_account.sql)
DEMO_ACCOUNTS=qwer1234
# CODEF (카드 승인내역, ⑤ 11/07). 콘솔 "키 관리"의 값 3개. 샌드박스면 CODEF_SERVICE_TYPE=sandbox, 데모 승인 후 demo
# public_key는 줄바꿈 없이 한 줄로 붙여 넣어요
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CODEF_SERVICE_TYPE=sandbox
# 카드사 연결 전 시험용 (card 테이블이 생기기 전까지, 데모에서만 씀): 카드사 기관코드, 카드사 연결 번호
CODEF_ORGANIZATION=
CODEF_CONNECTED_ID=
